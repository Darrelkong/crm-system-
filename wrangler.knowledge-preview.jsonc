{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crm-system-knowledge-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "knowledge-preview.echfronthk.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "crm-system-knowledge-preview"
    },
    {
      "binding": "AI_SERVICE",
      "service": "crm-ai-si2-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crm-db-si2-preview",
      "database_id": "66f0e690-25d1-45d2-aa16-197c5e7f0802",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "KNOWLEDGE_SOURCES",
      "bucket_name": "crm-knowledge-si2-preview"
    }
  ],
  "vars": {
    "CRM_ALLOW_MOCK_AI": "0",
    "CF_ACCESS_TEAM_DOMAIN": "https://echfronthk.cloudflareaccess.com",
    "CF_ACCESS_AUD": "d27bcc4a7d9eb513a24670e977ffde9a27d84916debcc6d447b6ef92b19ab272",
    "KNOWLEDGE_AI_DAILY_LIMIT": "20",
    "MAIL_NOTIFICATION_TRANSPORT_ENABLED": "false",
    "MAIL_OUTBOUND_TRANSPORT_MODE": "disabled",
    "MAIL_LARGE_ATTACHMENT_RUNTIME_ENABLED": "false",
    "MAIL_LARGE_ATTACHMENT_SEND_ENABLED": "false",
    "CRM_ALLOW_TEST_DB_BIND": "0",
    "MAIL_NOTIFICATION_VERIFICATION_TRANSPORT_MODE": "disabled"
  },
  "account_id": "809c05c9f500268e973938fd641eee39"
}
