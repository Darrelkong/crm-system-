{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm-system-mail-jobs-cron",
  "main": "workers/mail-jobs-cron.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["1-59/3 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crm-db",
      "database_id": "03633dd2-c058-42de-9355-f5450eab7202"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "crm-attachments",
      "preview_bucket_name": "crm-attachments-preview"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["notifications@send.echfronthk.com"]
    },
    {
      "name": "BUSINESS_EMAIL",
      "allowed_sender_addresses": ["daniel.hayes@echfronthk.com"]
    }
  ],
  "vars": {
    "MAIL_NOTIFICATION_TRANSPORT_ENABLED": "false",
    "MAIL_NOTIFICATION_VERIFICATION_TRANSPORT_MODE": "production",
    "MAIL_OUTBOUND_TRANSPORT_MODE": "production"
  }
}
