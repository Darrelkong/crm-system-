{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production CRM releases must use `npm run deploy:production`, which
  // rebuilds and validates `.open-next` before calling OpenNext deploy.
  "name": "crm-system",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "crm-system"
    },
    {
      "binding": "AI_SERVICE",
      "service": "crm-ai"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crm-db",
      "database_id": "03633dd2-c058-42de-9355-f5450eab7202",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "crm-attachments",
      "preview_bucket_name": "crm-attachments-preview"
    },
    {
      "binding": "LARGE_ATTACHMENTS",
      "bucket_name": "crm-mail-large-attachments",
      "preview_bucket_name": "crm-mail-large-attachments"
    }
  ],
  "routes": [
    {
      "pattern": "crm.echfronthk.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "MAIL_NOTIFICATION_VERIFICATION_TRANSPORT_MODE": "production"
  }
}
