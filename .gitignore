# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars

# vercel
.vercel

# cloudflare
.open-next/
.wrangler/
.deploy-size-*/
.local-backups/
.local-d1-backups/
.release-prep-backup/
backups/
backup-*.sql
pre-migrate-*.sql
*.sqlite
*.sqlite-wal
*.sqlite-shm

# typescript
*.tsbuildinfo
next-env.d.ts

# legacy sqlite databases
legacy/**/*.db
